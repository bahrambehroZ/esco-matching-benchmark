"""Re-compute Precision/Recall/F1/NDCG@5 from the team's blind human judgments (50 profiles, 432 judged pairs).
Usage: python evaluate_human_judgments.py
Recall is measured against the judged pool (all pairs judged for that profile), as in the paper."""
import argparse, glob, math, os
import numpy as np, pandas as pd
from scipy.stats import wilcoxon

K = 5
ap = argparse.ArgumentParser(); ap.add_argument("--dir", default="."); a = ap.parse_args()
rk = pd.read_csv(os.path.join(a.dir, "rankings.csv"))
j = pd.concat([pd.read_csv(f, encoding="utf-8-sig") for f in sorted(glob.glob(os.path.join(a.dir, "judgments_*.csv")))])
lab = j.groupby(["profile_id", "opp_id"])["relevance"].mean().reset_index()
lab["relevance"] = np.floor(lab.relevance + 0.5).astype(int)          # two judges: .5 rounds up
L = {(r.profile_id, int(r.opp_id)): int(r.relevance) for r in lab.itertuples()}
name = lambda m: "TF-IDF" if m == "tfidf" else "Hybrid" if m.startswith("hybrid") else "Embedding"
rows = []
for pid in sorted(rk.profile_id.unique()):
    pool = {o: g for (p, o), g in L.items() if p == pid}
    n_rel = sum(g >= 1 for g in pool.values())
    ideal = sorted(pool.values(), reverse=True)[:K]
    idcg = sum((2 ** g - 1) / math.log2(i + 2) for i, g in enumerate(ideal))
    for m, g in rk[rk.profile_id == pid].groupby("method"):
        rel = [L.get((pid, int(o)), 0) for o in g.sort_values("rank").opp_id.head(K)]
        hits = sum(r >= 1 for r in rel); p = hits / K; r = hits / n_rel if n_rel else 0
        f1 = 0 if p + r == 0 else 2 * p * r / (p + r)
        dcg = sum((2 ** x - 1) / math.log2(i + 2) for i, x in enumerate(rel))
        rows.append(dict(profile=pid, method=name(m), P=p, R=r, F1=f1, NDCG=dcg / idcg if idcg else 0))
d = pd.DataFrame(rows)
print(d.groupby("method")[["P", "R", "F1", "NDCG"]].mean().round(3).loc[["TF-IDF", "Embedding", "Hybrid"]])
piv = d.pivot(index="profile", columns="method")
for m in ("Embedding", "Hybrid"):
    for c in ("P", "R", "F1", "NDCG"):
        diff = (piv[(c, m)] - piv[(c, "TF-IDF")]).values
        print(f"{m} vs TF-IDF {c}: mean diff {diff.mean():+.3f}, Wilcoxon p = {1.0 if not diff.any() else wilcoxon(diff).pvalue:.3f}")
d.to_csv(os.path.join(a.dir, "per_profile_metrics.csv"), index=False)
